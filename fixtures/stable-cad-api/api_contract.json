{
  "api_version": "1.0.0",
  "error_codes": [
    "invalid_request",
    "revision_conflict",
    "confirmation_required",
    "resource_limit",
    "no_model",
    "no_source",
    "pending_changes",
    "io_error",
    "native_failure"
  ],
  "error_fields": [
    "api_version",
    "status",
    "code",
    "detail"
  ],
  "limits": {
    "checkpoints": 16,
    "model_nodes": 64,
    "source_bytes": 2000000,
    "workspace_edges": 512,
    "workspace_faces": 256,
    "workspace_triangles": 60000
  },
  "methods": {
    "candidates": "(self)",
    "compare": "(self)",
    "edit": "(self, node_id, parameter, value, *, expected_revision)",
    "export_step": "(self, path: 'Path', *, mode='reconstruct', overwrite=False)",
    "open_step": "(self, path: 'Path', *, mode='inspect')",
    "recompute": "(self, *, expected_revision)",
    "rollback": "(self, checkpoint=None, *, expected_revision)",
    "select": "(self, candidate_id, *, confirm=False, expected_revision)",
    "semantics": "(self)",
    "status": "(self)",
    "workspace": "(self, directory: 'Path')"
  },
  "result_fields": [
    "api_version",
    "operation",
    "status",
    "revision_token",
    "data",
    "warnings"
  ],
  "result_statuses": [
    "ok",
    "partial",
    "abstained",
    "staged",
    "committed",
    "aborted"
  ],
  "revision_policy": "opaque token required for select/edit/recompute/rollback; stale tokens fail without mutation",
  "scope": "method inputs, result envelope, statuses, error codes and declared limits; additive diagnostic data may evolve; no hard native CPU/RAM isolation"
}
