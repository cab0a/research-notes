* text=auto eol=lf
*.jpg binary
*.png binary
*.step text eol=lf whitespace=-blank-at-eol

# Upstream STEP and license snapshots are byte-preserved on every checkout.
fixtures/public-step-corpus/sources/** -text -whitespace
fixtures/public-step-corpus/licenses/** -text -whitespace
fixtures/revision-comparison/sources/** -text -whitespace
results/revision-benchmark/** -text

fixtures/hole-inventory/sources/** -text -whitespace
results/hole-inventory/** -text

# Native CAD exports are evidence: preserve exporter whitespace and exact bytes.
fixtures/cad-drawing-exports/inputs/** -text -whitespace
fixtures/cad-drawing-exports/evaluation/*.step -text -whitespace
fixtures/cad-drawing-exports/authoring/*.FCStd binary
results/cad-drawing-exports/*/input.* -text -whitespace
results/cad-svg-dxf/*/input.* -text -whitespace
fixtures/drawing-families/inputs/** -text -whitespace
fixtures/drawing-families/variants/** -text -whitespace
fixtures/drawing-families/evaluation/**/*.step -text -whitespace
fixtures/drawing-families/authoring/*.FCStd binary
fixtures/drawing-families/licenses/** -text -whitespace
results/drawing-families/*/input.* -text -whitespace
results/drawing-families/*.csv -text -whitespace
